[sub_resource type="CompositorEffect" id="CompositorEffect_4utdx"]
resource_local_to_scene = false
resource_name = ""
enabled = true
effect_callback_type = 4
needs_motion_vectors = false
needs_normal_roughness = false
script = ExtResource("2_upnw2")
compute_code = "
vec2 dir = vec2(1.000000, 0.000000);
ivec2 offset = ivec2(round(dir * params.effect.x * params.raster_size));
float r = imageLoad(color_image, clamp(uv + offset, ivec2(0), size - 1)).r;
float g = color.g;
float b = imageLoad(color_image, clamp(uv - offset, ivec2(0), size - 1)).b;
color = vec4(r, g, b, color.a);
"

