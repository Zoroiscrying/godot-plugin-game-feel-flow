# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Godot text resources should use LF
*.gd text=auto eol=lf
*.tscn text=auto eol=lf
*.tres text=auto eol=lf
*.cfg text=auto eol=lf
*.import text=auto eol=lf

# Binary assets (no LFS — keep as regular Git binaries)
*.png binary
*.jpg binary
*.jpeg binary
*.svg binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary

# ==========================================
# Godot Asset Library — official addon pattern
# Only ship addons/ in the downloaded ZIP.
# https://docs.godotengine.org/en/stable/community/asset_library/submitting_to_assetlib.html
# ==========================================
/** export-ignore
/addons !export-ignore
/addons/** !export-ignore

# Free package only: keep Pro and test framework out of Asset Library ZIP
/addons/game_feel_flow_pro/ export-ignore
/addons/game_feel_flow_pro/** export-ignore
/addons/gdUnit4/ export-ignore
/addons/gdUnit4/** export-ignore
